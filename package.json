{
  "name": "bplus-player",
  "version": "1.0.11",
  "description": "B+ media player",
  "main": "app/main.js",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --dir",
    "test": "node --test tests/*.test.cjs"
  },
  "devDependencies": {
    "electron": "45.2.1+wvcus",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.bplus.player",
    "productName": "B+",
    "directories": {
      "output": "dist"
    },
    "files": [
      "app/**",
      "package.json",
      "LICENSE",
      "THIRD_PARTY_NOTICES.txt"
    ],
    "win": {
      "target": [
        "dir"
      ],
      "icon": "build/icon.png"
    },
    "portable": {
      "artifactName": "Bplus-1.9.2-portable.exe"
    },
    "linux": {
      "target": [
        "zip"
      ],
      "icon": "build/icon.png"
    },
    "electronDist": "/tmp/electron-win.zip",
    "compression": "normal",
    "electronLanguages": [
      "en-US",
      "ar"
    ],
    "extraResources": [
      {
        "from": "vendor/ffmpeg",
        "to": "ffmpeg"
      }
    ]
  }
}